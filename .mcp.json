{
  "mcpServers": {
    "lark-docs": {
      "command": "bunx",
      "args": [
        "--registry=http://bnpm.byted.org/",
        "@byted/mcp-lark-docs-ext@latest"
      ],
      "env": {
        "NPM_CONFIG_REGISTRY": "http://bnpm.byted.org/",
        "AUTH_CALLBACK_PORT": "6688",
        "AUTH_CALLBACK_ENDPOINT": "/lark/callback",
        "LARK_TENANT": "bytedance"
      }
    },
    "tiksearch": {
      "command": "bunx",
      "args": [
        "--registry=http://bnpm.byted.org/",
        "@tiktok-mcp/tiksearch"
      ],
      "env": {
        "NPM_CONFIG_REGISTRY": "http://bnpm.byted.org/",
        "TIKSEARCH_ENV": "office"
      }
    },
    "parkride": {
      "command": "/opt/homebrew/bin/python3.11",
      "args": ["mcp_server.py"],
      "cwd": "/Users/bytedance/work/python/park_ride"
    }
  }
}